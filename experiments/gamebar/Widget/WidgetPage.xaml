<Page x:Class="RiftReady.GameBar.WidgetPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent" UseLayoutRounding="True">
 <Grid x:Name="OverlayRoot" Background="Transparent">
  <Canvas x:Name="LiveCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
  <Border x:Name="HelpCard" Width="390" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F0151D24" BorderBrush="#315D60" BorderThickness="1" CornerRadius="8">
   <StackPanel Spacing="8"><TextBlock Text="RIFT READY" Foreground="#42CDC6" FontSize="13" FontWeight="SemiBold" CharacterSpacing="120" /><TextBlock x:Name="Help" Text="Press Win + G and pin Rift Ready. Enable Game Bar click-through so clicks reach League." Foreground="#C5D1DA" FontSize="12" TextWrapping="Wrap" /></StackPanel>
  </Border>
 </Grid>
</Page>
